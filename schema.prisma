// Home Automation ERP — Prisma schema
// All entities + relations for the 10 modules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================ Sessions & Security ============================

model Session {
  
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ============================ RBAC ============================

model User {
  id           String    @id @default(cuid())
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Role {
 

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

// ============================ Departments ============================

model Department {
  id        String   @id @default(cuid())
 
  status    String   @default("Active") // Active | Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================ HRM ============================

model Employee {
  id               String          @id @default(cuid())
  empId            String          @unique
  name             String

  attendance      Attendance[]
  payroll         Payroll[]
  workLogs        WorkLog[]
  serviceHist     ServiceHistory[]
  assemblies      Assembly[]
  indents         Indent[]
  shiftAssignments ShiftAssignment[]
  salaryHistory   SalaryHistory[]
  issueSlips      IssueSlip[]
}

model Attendance {
  id            String   @id @default(cuid())
  checkInLng    Float?
  checkOutLat   Float?
  checkOutLng   Float?
  correctedBy   String   @default("")
  correctionNote String  @default("") @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AttendanceArea {
  id        String   @id @default(cuid())
  name      String   @unique
  latitude  Float
  longitude Float
  radius    Int      @default(200) // meters
  status    String   @default("Active") // Active | Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model ShiftLog {
  id            String   @id @default(cuid())
  onLeave       Int      @default(0)
  attendancePct Float    @default(0)
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Shift {
  id          String     @id @default(cuid())
  name        String     @unique // e.g. "A", "B", "C", "General", "Night"
  code        String     @unique // e.g. "SHIFT-A"
  startTime   String // e.g. "08:00"
  endTime     String // e.g. "17:00"
  updatedAt   DateTime   @updatedAt
  logs        ShiftLog[]
  assignments ShiftAssignment[]
}

// Effective-dated shift assignment history.
// The shift applicable on a given attendance date is resolved from these rows
// (latest effectiveFrom <= date, effectiveTo inclusive, null = open-ended).
// Employee.shift stays as the denormalized "current" shift for display/back-compat.
model ShiftAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
}

// Effective-dated salary history so mid-month salary changes are prorated
// correctly per period. Employee.salary stays as the "current" salary.
model SalaryHistory {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salary        Float
  effectiveFrom DateTime
}

model Payroll {

  earned          Float     @default(0) // salary earned from attendance (before deductions)
  absenceDed      Float     @default(0) // loss-of-pay for absent days (gross − earned)

  status          String    @default("Pending") // Pending | Processing | Paid | On Hold
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================ Inventory ============================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("Active") // Active | Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================ Procurement ============================

model VendorCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("Active") // Active | Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================ Finance ============================

model ExpenseCategory {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id       String @id @default(cuid())
 
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Component {
  id           String     @id @default(cuid())
  sku          String     @unique
  name         String
  category     String
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  qty          Int        @default(0)
  reorderLevel Int        @default(10)
  unitCost     Float      @default(0)
  status       String     @default("In Stock") // In Stock | Low Stock | Out of Stock
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  purchaseOrderItems PurchaseOrderItem[]
  indentItems        IndentItem[]
  issueSlipItems     IssueSlipItem[]
}

model Product {
  id          String     @id @default(cuid())
  sku         String     @unique

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  serials            SerialNumber[]
  assemblies         Assembly[]
  dispatches         Dispatch[]
  dispatchItems      DispatchItem[]
  workLogs           WorkLog[]
}

model StockMovement {

  date      DateTime @default(now())
  createdAt DateTime @default(now())
  issueSlipId String?
  issueSlip   IssueSlip? @relation(fields: [issueSlipId], references: [id])
}

model Assembly {
 
  operatorId String?
  operator   Employee? @relation(fields: [operatorId], references: [id])
  status     String    @default("Pending") // Pending | In Progress | Completed
  date       DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Dispatch {
 
  note      String   @default("") @db.Text // Delivery note (e.g. for Offline Delivery)
  consignmentValue Float @default(0)
  eWayBillNumber String @default("")
  eWayBillDate   DateTime?
  updatedAt DateTime @updatedAt

  items DispatchItem[]
}

model DispatchItem {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  productName String  @default("")
  qty        Int

  @@index([dispatchId])
}

// ============================ Issue Slips ============================

model IssueSlip {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  status       String    @default("Issued") // Issued | Partially Returned | Returned

  items IssueSlipItem[]
  returns IssueSlipReturn[]
  stockMovements StockMovement[]
}

model IssueSlipItem {
 
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id])
  itemName    String     @default("") // Snapshot at time of issue
  qty         Int

  returns IssueSlipReturnItem[]

  @@index([issueSlipId])
}

model IssueSlipReturn {
  id          String                 @id @default(cuid())
  issueSlipId String

  items IssueSlipReturnItem[]
}

model IssueSlipReturnItem {
  id               String          @id @default(cuid())
  issueSlipReturnId String
  issueSlipReturn  IssueSlipReturn @relation(fields: [issueSlipReturnId], references: [id], onDelete: Cascade)
  issueSlipItemId  String

// ============================ Procurement ============================

model Vendor {
  id        String   @id @default(cuid())
  name      String
  contact   String
  email     String   @default("")
  address   String   @default("")
  gstin     String   @default("")

}

model PurchaseOrder {
  id          String    @id @default(cuid())
 
  qty         Int       @default(1) // Legacy: single item qty (sum of line items for new POs)
  unitCost    Float     @default(0) // Legacy: single item unit cost
  value       Float // Grand total of all line items
  receivedQty Int       @default(0) // Tracks how much qty was applied to inventory
  expected    DateTime


  lineItems PurchaseOrderItem[]
  payments  Expense[]
}

// ============================ Indents (Procurement Requests) ============================

model Indent {

  approvedAt     DateTime?
  rejectionNote  String    @default("") @db.Text
  date           DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lineItems      IndentItem[]
  purchaseOrders PurchaseOrder[]
}

model IndentItem {

  product     Product?   @relation(fields: [productId], references: [id])
  itemName    String     @default("")
  qty         Int
  notes       String     @default("") @db.Text

  @@index([indentId])
}

model PurchaseOrderItem {

  product         Product?      @relation(fields: [productId], references: [id])
  componentName   String        @default("") // Snapshot of item name (component or product)
  qty             Int
  unitCost        Float
  lineTotal       Float         @default(0) // qty × unitCost

  @@index([purchaseOrderId])
}

// ============================ Finance ============================

model BankAccount {

  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoices Invoice[]
  income   Income[]
  expenses Expense[]

  @@index([clientId])
}

model Client {


  dispatches  Dispatch[]
  workLogs    WorkLog[]
  serviceHist ServiceHistory[]
  invoices    Invoice[]
  income      Income[]
  quotations  Quotation[]
  bankAccounts BankAccount[]
}

model Income {

  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  date          DateTime     @default(now())
  amount        Float
  status        String       @default("Received") // Received | Pending
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([date])
  @@index([clientId])
  @@index([invoiceId])
  @@index([bankAccountId])
}

// ============================ Quotations ============================

model Quotation {

  taxPercent  Float    @default(0) // CGST% + SGST% (combined total)
  taxAmount   Float    @default(0) // CGST + SGST (combined total)
  discount    Float    @default(0)
  total       Float    @default(0)
  notes       String   @default("") @db.Text
  terms       String   @default("") @db.Text
  status      String   @default("Draft") // Draft | Sent | Accepted | Rejected | Expired | Invoiced
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    QuotationItem[]
  invoices Invoice[]

  @@index([clientId])
  @@index([status])
}

model QuotationItem {
  product     Product   @relation(fields: [productId], references: [id])
  productName String    @default("")
  qty         Int
  price       Float
  lineTotal   Float     @default(0)

  @@index([quotationId])
}

model Expense {
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  bankAccountId   String?
  bankAccount     BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  date            DateTime       @default(now())
  @@index([status])
  @@index([date])
  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([bankAccountId])
}

model Invoice {
  id         String   @id @default(cuid())
  invNumber  String   @unique
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  cgstPercent Float    @default(0)
  cgstAmount  Float    @default(0)
  transporterId  String @default("")
  vehicleNumber  String @default("")
  paymentMethod  String @default("") // Bank Transfer | Cash | UPI | Cheque | Other

  items    InvoiceItem[]
  payments Income[]

  @@index([clientId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
  @@index([bankAccountId])
  @@index([quotationId])

}

model BillRun {
 
  amount    Float
  date      DateTime @default(now())
  status    String   @default("Completed") // Completed | Disputed | Pending
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================ Service & Work Logs ============================

model WorkLog {
  product          Product?      @relation(fields: [productId], references: [id])
  serialNumberId   String?
  serial           SerialNumber? @relation(fields: [serialNumberId], references: [id])
  jobDescription   String        @db.Text
  replacementParts String        @default("") @db.Text
  date             DateTime      @default(now())

  images WorkLogImage[]
}

model WorkLogImage {
 
  filename  String
  path      String   @db.Text // Relative path: /uploads/worklog/...
  mimeType  String
  size      Int      // bytes
  createdAt DateTime @default(now())

  @@index([workLogId])
}

model ServiceHistory {
lt(now())
  updatedAt          DateTime      @updatedAt
}

// ============================ Barcode & Serial Numbers ============================

model SerialNumber {
 
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id]
  @@index([productId])
  @@index([warehouseId])
}

model ScanLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model LabelPrintLog {

  printedBy      String   @default("") // User name

  @@index([serialNumberId])
  @@index([printedAt])
}
